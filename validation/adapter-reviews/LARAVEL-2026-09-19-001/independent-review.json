  "findings": [
    {
      "id": "IR-001",
      "severity": "High",
      "adapters": [
        "BE-007",
        "BE-008"
      ],
      "issue": "Unbounded database reads escape verification. Replacing SQL pagination with get()->slice()->values() passes unchanged tests (116 and 220 assertions), despite the explicit prohibition on loading all records. Query counts and response lengths do not establish bounded database reads.",
      "required_action": "Add reviewer-owned assertions for bounded database retrieval and sensitivity to a load-all/slice variant; freeze a new adapter version and independently reverify.",
      "evidence": [
        "probes/BE-007/result.json",
        "probes/BE-008/result.json"

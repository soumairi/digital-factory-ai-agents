+        foreach ([[],['name'=>null,'quantity'=>1],['name'=>'   ','quantity'=>1],['name'=>'x','quantity'=>'1'],['name'=>'x','quantity'=>1001],['name'=>'x','quantity'=>1,'extra'=>['role'=>'editor']]] as $payload) {
+            $this->reject('POST','products',$payload,'products');

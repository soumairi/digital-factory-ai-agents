+        $p=EvalProfile::where('owner_id',$r->user()->id)->where('tenant_id',$r->user()->tenant_id)->firstOrFail();
+        $p->fill($data)->save(); return response()->json(['display_name'=>$p->display_name]);
+    }
+    public function reserve(Request $r,EvalReserve $reserve) {
+        $data=EvalInput::fields($r,['quantity'=>'required|integer|min:1|max:1000'],['quantity']);
+        try { return response()->json(['id'=>$reserve->execute($data['quantity'])],201); }
+        catch(\DomainException $e) { return response()->json(['message'=>'Insufficient stock.'],409); }
+        catch(\RuntimeException $e) { return response()->json(['message'=>'Reservation failed.'],500); }
+    }
+    public function records(Request $r) {
